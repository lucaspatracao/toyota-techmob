# URL base da API Spring Boot.
# Dev local (default no código se a variável não existir): http://localhost:8080
# Produção: URL do serviço no Render, ex.: https://techmob-backend.onrender.com
VITE_API_URL=http://localhost:8080

# ID da máquina a ser consultada (hoje só existe a Bancada Smart 4.0).
VITE_MAQUINA_ID=1
