# URL base da API Spring Boot (sem a variável, o código usa http://localhost:8080).
VITE_API_URL=http://localhost:8080

# Máquina consultada pelas telas (seed do infra/schema.sql: 1, a Bancada Smart 4.0).
VITE_MAQUINA_ID=1

# Intervalo entre as consultas à API, em ms (padrão 2000). O backend lê a
# bancada a cada 1 s; menos que isso não traz dado novo.
VITE_POLLING_MS=2000
